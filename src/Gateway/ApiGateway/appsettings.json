{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-products": {
        "ClusterId": "catalog",
        "CorsPolicy": "frontend",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "auction-auctions": {
        "ClusterId": "auction",
        "CorsPolicy": "frontend",
        "Match": {
          "Path": "/api/auctions/{**catch-all}"
        }
      },
      "auction-hub": {
        "ClusterId": "auction",
        "CorsPolicy": "frontend",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "catalog-health": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/health/catalog"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      },
      "auction-health": {
        "ClusterId": "auction",
        "Match": {
          "Path": "/health/auction"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog-1": {
            "Address": "http://localhost:5005/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        }
      },
      "auction": {
        "Destinations": {
          "auction-1": {
            "Address": "http://localhost:5112/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "3"
        },
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": "auction.affinity",
          "Cookie": {
            "SameSite": "Lax",
            "HttpOnly": true
          }
        }
      }
    }
  }
}
